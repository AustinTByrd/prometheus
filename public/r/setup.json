{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "setup",
  "title": "Prometheus setup",
  "description": "Install every Prometheus component and system lib into an existing shadcn app. Use --overwrite. Then wrap the root in Providers from components/providers.tsx.",
  "dependencies": [
    "class-variance-authority",
    "clsx",
    "tailwind-merge",
    "tw-animate-css",
    "@heroicons/react",
    "next-themes",
    "@base-ui/react",
    "geist",
    "motion"
  ],
  "registryDependencies": [
    "utils",
    "font-geist",
    "AustinTByrd/prometheus/theme",
    "AustinTByrd/prometheus/motion",
    "AustinTByrd/prometheus/typography",
    "AustinTByrd/prometheus/breakpoints",
    "AustinTByrd/prometheus/smooth-corners",
    "AustinTByrd/prometheus/elevated",
    "AustinTByrd/prometheus/fluid-hover",
    "AustinTByrd/prometheus/springs",
    "AustinTByrd/prometheus/omit",
    "AustinTByrd/prometheus/font-weight",
    "AustinTByrd/prometheus/size-context",
    "AustinTByrd/prometheus/shape-context",
    "AustinTByrd/prometheus/prometheus-provider",
    "AustinTByrd/prometheus/button",
    "AustinTByrd/prometheus/toggle-button",
    "AustinTByrd/prometheus/checkbox",
    "AustinTByrd/prometheus/checkbox-group",
    "AustinTByrd/prometheus/switch",
    "AustinTByrd/prometheus/radio-group",
    "AustinTByrd/prometheus/input",
    "AustinTByrd/prometheus/textarea",
    "AustinTByrd/prometheus/dialog",
    "AustinTByrd/prometheus/select",
    "AustinTByrd/prometheus/menu",
    "AustinTByrd/prometheus/slider",
    "AustinTByrd/prometheus/tooltip",
    "AustinTByrd/prometheus/lightbox",
    "AustinTByrd/prometheus/drawer",
    "AustinTByrd/prometheus/sheet",
    "AustinTByrd/prometheus/table",
    "AustinTByrd/prometheus/sidebar",
    "AustinTByrd/prometheus/app-shell",
    "AustinTByrd/prometheus/skeleton",
    "AustinTByrd/prometheus/empty",
    "AustinTByrd/prometheus/error",
    "AustinTByrd/prometheus/form",
    "AustinTByrd/prometheus/data-display",
    "AustinTByrd/prometheus/badge",
    "AustinTByrd/prometheus/list",
    "AustinTByrd/prometheus/tabs",
    "AustinTByrd/prometheus/agent",
    "AustinTByrd/prometheus/changelog"
  ],
  "files": [
    {
      "path": "registry/base/starter-providers.tsx",
      "content": "\"use client\"\n\n// Generated by Prometheus starter / setup.\n// Change defaults here; every component follows.\n\nimport { PrometheusProvider } from \"@/components/prometheus-provider\"\n\nexport function Providers({ children }: { children: React.ReactNode }) {\n  return (\n    <PrometheusProvider\n      defaultTheme=\"system\"\n      enableSystem\n      size=\"default\"\n      shape=\"rounded\"\n    >\n      {children}\n    </PrometheusProvider>\n  )\n}\n",
      "type": "registry:component",
      "target": "components/providers.tsx"
    }
  ],
  "cssVars": {
    "theme": {
      "font-sans": "Geist, Geist Fallback, ui-sans-serif, system-ui, sans-serif",
      "font-mono": "Geist Mono, Geist Mono Fallback, ui-monospace, monospace",
      "radius": "0.75rem",
      "color-hover": "var(--hover)",
      "color-hover-light": "var(--hover-light)"
    },
    "light": {
      "background": "#F7F6F2",
      "foreground": "#73574A",
      "card": "#FFFFFF",
      "card-foreground": "#73574A",
      "popover": "#FFFFFF",
      "popover-foreground": "#73574A",
      "primary": "#73574A",
      "primary-foreground": "#FEF1DF",
      "secondary": "#EDECE8",
      "secondary-foreground": "#73574A",
      "muted": "#EDECE8",
      "muted-foreground": "#7E756C",
      "hover": "rgb(from var(--foreground) r g b / 8%)",
      "accent": "#EDECE8",
      "accent-foreground": "#73574A",
      "destructive": "oklch(0.577 0.245 27.325)",
      "border": "#E6E4DE",
      "input": "#E0DDD6",
      "ring": "#73574A",
      "chart-1": "#73574A",
      "chart-2": "#5B793F",
      "chart-3": "#5B5DDF",
      "chart-4": "#7E756C",
      "chart-5": "#9A918A",
      "sidebar": "#F7F6F2",
      "sidebar-foreground": "#73574A",
      "sidebar-primary": "#73574A",
      "sidebar-primary-foreground": "#FEF1DF",
      "sidebar-accent": "#EDECE8",
      "sidebar-accent-foreground": "#73574A",
      "sidebar-border": "#E6E4DE",
      "sidebar-ring": "#7E756C",
      "hover-light": "rgb(from var(--foreground) r g b / 4%)"
    },
    "dark": {
      "background": "#1C1918",
      "foreground": "#FEF1DF",
      "card": "#2C2926",
      "card-foreground": "#FEF1DF",
      "popover": "#2C2926",
      "popover-foreground": "#FEF1DF",
      "primary": "#FEF1DF",
      "primary-foreground": "#73574A",
      "secondary": "#FEF1DF1A",
      "secondary-foreground": "#FEF1DF",
      "muted": "#FEF1DF1A",
      "muted-foreground": "#9A928A",
      "accent": "#FEF1DF1A",
      "accent-foreground": "#FEF1DF",
      "destructive": "oklch(0.704 0.191 22.216)",
      "border": "#FFFFFF14",
      "input": "#FFFFFF1F",
      "ring": "#FEF1DF",
      "chart-1": "#FEF1DF",
      "chart-2": "#8FA876",
      "chart-3": "#8B8DE8",
      "chart-4": "#9A928A",
      "chart-5": "#B89A8A",
      "sidebar": "#1C1918",
      "sidebar-foreground": "#FEF1DF",
      "sidebar-primary": "#FEF1DF",
      "sidebar-primary-foreground": "#73574A",
      "sidebar-accent": "#FEF1DF1A",
      "sidebar-accent-foreground": "#FEF1DF",
      "sidebar-border": "#FFFFFF14",
      "sidebar-ring": "#9A928A",
      "hover": "rgb(from var(--foreground) r g b / 8%)",
      "hover-light": "rgb(from var(--foreground) r g b / 4%)"
    }
  },
  "docs": "After install, wrap children in <Providers /> from components/providers.tsx. Docs: https://prometheus-ui-rust.vercel.app",
  "type": "registry:block"
}