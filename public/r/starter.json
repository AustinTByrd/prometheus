{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "starter",
  "title": "Prometheus starter",
  "description": "A Next.js app with every Prometheus component installed and the system wired: Base UI, soft radius, default size, Heroicons, system theme, umber accent. Configure further from the docs Make them yours panel.",
