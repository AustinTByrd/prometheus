    }
  },
  "docs": "Docs: https://prometheus-ui-rust.vercel.app. Copy the install prompt from any docs page to bake in your Make them yours choices.",
  "type": "registry:base",
  "config": {
    "style": "base-nova",
    "rsc": true,
    "tsx": true,
    "tailwind": {
      "baseColor": "neutral"
    },
    "iconLibrary": "lucide",
    "registries": {
      "@prometheus": "https://prometheus-ui-rust.vercel.app/r/{name}.json"
    }
  }
}