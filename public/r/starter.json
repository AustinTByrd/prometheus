  "files": [
    {
      "path": "registry/base/starter-layout.tsx",
      "content": "import type { Metadata } from \"next\"\nimport { Geist, Geist_Mono } from \"next/font/google\"\nimport localFont from \"next/font/local\"\n\nimport { Providers } from \"@/components/providers\"\n\nimport \"./globals.css\"\n\nconst geistSans = Geist({\n  variable: \"--font-geist-sans\",\n  subsets: [\"latin\"],\n})\n\nconst geistMono = Geist_Mono({\n  variable: \"--font-geist-mono\",\n  subsets: [\"latin\"],\n})\n\nconst geistSerif = localFont({\n  src: \"../node_modules/geist/dist/fonts/geist-serif/GeistSerifVF.woff2\",\n  variable: \"--font-geist-serif\",\n  weight: \"100 900\",\n  fallback: [\"Times New Roman\", \"Times\", \"serif\"],\n  adjustFontFallback: \"Times New Roman\",\n})\n\nexport const metadata: Metadata = {\n  title: \"My app\",\n  description: \"Built with Prometheus.\",\n}\n\nexport default function RootLayout({\n  children,\n}: Readonly<{\n  children: React.ReactNode\n}>) {\n  return (\n    <html\n      className={`${geistSans.variable} ${geistMono.variable} ${geistSerif.variable}`}\n      lang=\"en\"\n      suppressHydrationWarning\n    >\n      <body className=\"min-h-svh antialiased\">\n        <Providers>{children}</Providers>\n      </body>\n    </html>\n  )\n}\n",
      "type": "registry:file",
      "target": "app/layout.tsx"
    },
    {
      "path": "registry/base/starter-page.tsx",
      "content": "import { AppShell } from \"@/components/ui/app-shell\"\n\nexport default function Page() {\n  return (\n    <AppShell\n      nav={\n        <div className=\"flex flex-col gap-1 p-2 text-sm text-muted-foreground\">\n          <p className=\"px-2 py-1.5 font-medium text-foreground\">Prometheus</p>\n          <p className=\"px-2 py-1.5\">Replace this nav</p>\n        </div>\n      }\n    >\n      <div className=\"flex flex-col gap-3 p-6\">\n        <h1 className=\"font-display text-3xl\">Your app starts here</h1>\n        <p className=\"max-w-prose text-muted-foreground\">\n          Every Prometheus component is in components/ui. Edit this page, and\n          change defaults in components/providers.tsx.\n        </p>\n      </div>\n    </AppShell>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/page.tsx"
    },
    {
      "path": "registry/base/starter-providers.tsx",
      "content": "\"use client\"\n\n// Generated by Prometheus starter / setup.\n// Change defaults here; every component follows.\n\nimport { PrometheusProvider } from \"@/components/prometheus-provider\"\n\nexport function Providers({ children }: { children: React.ReactNode }) {\n  return (\n    <PrometheusProvider\n      defaultTheme=\"system\"\n      enableSystem\n      size=\"default\"\n      shape=\"rounded\"\n    >\n      {children}\n    </PrometheusProvider>\n  )\n}\n",
      "type": "registry:component",
      "target": "components/providers.tsx"
    }
  ],
  "cssVars": {
    "theme": {
      "font-sans": "Geist, Geist Fallback, ui-sans-serif, system-ui, sans-serif",
      "font-mono": "Geist Mono, Geist Mono Fallback, ui-monospace, monospace",
      "radius": "0.75rem",
      "color-hover": "var(--hover)",
      "color-hover-light": "var(--hover-light)"
    },
    "light": {
      "background": "#F7F6F2",
      "foreground": "#73574A",
      "card": "#FFFFFF",
      "card-foreground": "#73574A",
      "popover": "#FFFFFF",
      "popover-foreground": "#73574A",
      "primary": "#73574A",
      "primary-foreground": "#FEF1DF",
      "secondary": "#EDECE8",
      "secondary-foreground": "#73574A",
      "muted": "#EDECE8",
      "muted-foreground": "#7E756C",
      "hover": "rgb(from var(--foreground) r g b / 8%)",
      "accent": "#EDECE8",
      "accent-foreground": "#73574A",
      "destructive": "oklch(0.577 0.245 27.325)",
      "border": "#E6E4DE",
      "input": "#E0DDD6",
      "ring": "#73574A",
      "chart-1": "#73574A",
      "chart-2": "#5B793F",
      "chart-3": "#5B5DDF",
      "chart-4": "#7E756C",
      "chart-5": "#9A918A",
      "sidebar": "#F7F6F2",
      "sidebar-foreground": "#73574A",
      "sidebar-primary": "#73574A",
      "sidebar-primary-foreground": "#FEF1DF",
      "sidebar-accent": "#EDECE8",
      "sidebar-accent-foreground": "#73574A",
