{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "motion",
      "type": "registry:lib",
      "title": "Motion",
      "description": "Shared durations, easing, and the height spring. Import these instead of inventing a second curve.",
      "cssVars": {
        "theme": {
          "duration-instant": "120ms",
          "duration-fast": "160ms",
          "duration-exit": "180ms",
          "duration-standard": "240ms",
          "duration-considered": "480ms",
          "ease-enter": "cubic-bezier(0.16, 1, 0.3, 1)",
          "ease-standard": "cubic-bezier(0.22, 1, 0.36, 1)",
          "ease-exit": "cubic-bezier(0.7, 0, 0.84, 0)"
        }
      },
      "files": [
        {
          "path": "motion.ts",
          "type": "registry:lib",
          "target": "lib/motion.ts"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:lib",
      "title": "Theme",
      "description": "Portable Prometheus extension tokens derived from the host theme. Ships --hover / --hover-light / --active / --selected and Tailwind color bridges so Fluid Hover, Slider fills, and controls work without this app’s globals.css. Depends on motion.",
      "registryDependencies": [
        "AustinTByrd/prometheus/motion"
      ],
      "cssVars": {
        "theme": {
          "color-hover": "var(--hover)",
          "color-hover-light": "var(--hover-light)",
          "color-active": "var(--active)",
          "color-selected": "var(--selected)"
        },
        "light": {
          "hover": "rgb(from var(--foreground) r g b / 8%)",
          "hover-light": "rgb(from var(--foreground) r g b / 4%)",
          "active": "rgb(from var(--foreground) r g b / 12%)",
          "selected": "color-mix(in oklab, var(--foreground) 16%, var(--background))",
          "focus-ring": "var(--ring)"
        },
        "dark": {
          "hover": "rgb(from var(--foreground) r g b / 8%)",
          "hover-light": "rgb(from var(--foreground) r g b / 4%)",
          "active": "rgb(from var(--foreground) r g b / 14%)",
          "selected": "color-mix(in oklab, var(--foreground) 22%, var(--background))",
          "focus-ring": "var(--ring)"
        }
      },
      "files": [
        {
          "path": "theme.ts",
          "type": "registry:lib",
          "target": "lib/theme.ts"
        }
      ]
    },
    {
      "name": "typography",
      "type": "registry:lib",
      "title": "Typography",
      "description": "Type ramp from text-xs through text-5xl. Each step sets size, line-height, and tracking. Titles from text-xl use font-display. Long-form copy uses prose. Drop caps use drop-cap (2 lines), drop-cap-3, or drop-cap-4.",
      "cssVars": {
        "theme": {
          "text-xs": "0.75rem",
          "text-xs--line-height": "1rem",
          "text-xs--letter-spacing": "0.02em",
          "text-sm": "0.875rem",
          "text-sm--line-height": "1.25rem",
          "text-sm--letter-spacing": "0.01em",
          "text-base": "1rem",
          "text-base--line-height": "1.5rem",
          "text-base--letter-spacing": "0em",
          "text-lg": "1.125rem",
          "text-lg--line-height": "1.75rem",
          "text-lg--letter-spacing": "-0.01em",
          "text-xl": "1.25rem",
          "text-xl--line-height": "1.75rem",
          "text-xl--letter-spacing": "-0.02em",
          "text-2xl": "1.5rem",
          "text-2xl--line-height": "2rem",
          "text-2xl--letter-spacing": "-0.025em",
          "text-3xl": "1.875rem",
          "text-3xl--line-height": "2.25rem",
          "text-3xl--letter-spacing": "-0.03em",
          "text-4xl": "2.25rem",
          "text-4xl--line-height": "2.75rem",
          "text-4xl--letter-spacing": "-0.03em",
          "text-5xl": "3rem",
          "text-5xl--line-height": "3.5rem",
          "text-5xl--letter-spacing": "-0.035em",
          "text-6xl--letter-spacing": "-0.04em",
          "text-7xl--letter-spacing": "-0.04em",
          "text-8xl--letter-spacing": "-0.04em",
          "text-9xl--letter-spacing": "-0.04em"
        }
      },
      "css": {
        "@layer base": {
          ".font-display": {
            "font-family": "var(--font-geist-serif), \"Times New Roman\", serif",
            "font-weight": "500",
            "font-variant-ligatures": "none"
          },
          ".prose": {
            "max-width": "65ch",
            "font-size": "var(--text-base)",
            "line-height": "var(--text-base--line-height)",
            "letter-spacing": "var(--text-base--letter-spacing)",
            "color": "var(--foreground)"
          },
          ".prose > * + *": {
            "margin-top": "0.75em"
          },
          ".prose :where(h1, h2, h3)": {
            "font-family": "var(--font-geist-serif), \"Times New Roman\", serif",
            "font-weight": "500",
            "font-variant-ligatures": "none",
            "text-wrap": "balance"
          },
          ".prose :where(h1)": {
            "font-size": "var(--text-4xl)",
            "line-height": "var(--text-4xl--line-height)",
            "letter-spacing": "var(--text-4xl--letter-spacing)"
          },
          ".prose > * + :where(h1)": {
            "margin-top": "0"
          },
          ".prose :where(h2)": {
            "font-size": "var(--text-2xl)",
            "line-height": "var(--text-2xl--line-height)",
            "letter-spacing": "var(--text-2xl--letter-spacing)"
          },
          ".prose > * + :where(h2)": {
            "margin-top": "1.5em"
          },
          ".prose :where(h3)": {
            "font-size": "var(--text-xl)",
            "line-height": "var(--text-xl--line-height)",
            "letter-spacing": "var(--text-xl--letter-spacing)"
          },
          ".prose > * + :where(h3)": {
            "margin-top": "1.25em"
          },
          ".prose :where(p, ul, ol)": {
            "text-wrap": "pretty"
          },
          ".prose :where(a)": {
            "text-decoration-line": "underline",
            "text-decoration-color": "color-mix(in oklab, var(--foreground) 40%, transparent)",
            "text-underline-offset": "0.15em"
          },
          ".prose :where(strong)": {
            "font-weight": "500"
          },
          ".prose :where(ul, ol)": {
            "padding-left": "1.25rem"
          },
          ".prose :where(ul)": {
            "list-style-type": "disc"
          },
          ".prose :where(ol)": {
            "list-style-type": "decimal"
          },
          ".prose :where(li + li)": {
            "margin-top": "0.25em"
          },
          ".prose :where(code)": {
            "font-family": "var(--font-mono), ui-monospace, monospace",
            "font-size": "0.875em",
            "background": "var(--muted)",
            "border-radius": "0.25rem",
            "padding": "0.1em 0.35em"
          },
          ".drop-cap, .drop-cap-3, .drop-cap-4": {
            "--drop-cap-lines": "2"
          },
          ".drop-cap-3": {
            "--drop-cap-lines": "3"
          },
          ".drop-cap-4": {
            "--drop-cap-lines": "4"
          },
          ".drop-cap::first-letter, .drop-cap-3::first-letter, .drop-cap-4::first-letter, .prose.drop-cap > p:first-of-type::first-letter, .prose.drop-cap-3 > p:first-of-type::first-letter, .prose.drop-cap-4 > p:first-of-type::first-letter": {
            "float": "left",
            "font-family": "var(--font-geist-serif), \"Times New Roman\", serif",
            "font-weight": "500",
            "font-variant-ligatures": "none",
            "font-size": "calc(max(2, var(--drop-cap-lines, 2)) * 1lh)",
            "line-height": "1",
            "margin-right": "0.1em",
            "padding-top": "0",
            "color": "var(--foreground)"
          }
        }
      },
      "files": [
        {
          "path": "typography.ts",
          "type": "registry:lib",
          "target": "lib/typography.ts"
        }
      ]
    },
