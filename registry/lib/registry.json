    {
      "name": "smooth-corners",
      "type": "registry:lib",
      "title": "Smooth Corners",
      "description": "Lisse squircles for Prometheus panels and overlays. CORNERS match --radius* tokens. Squircle curve with smoothing 1 by default. Use useCornerRef on Base UI popups; Elevated and overlays already apply it. Pill and circle stay CSS rounded-full.",
      "dependencies": [
        "@lisse/react",
        "@lisse/core"
      ],
      "css": {
        "@layer utilities": {
          "[data-slot=\"smooth-corners\"][data-state=\"ready\"]": {
            "border-radius": "0 !important"
          }
        }
      },
      "files": [
        {
          "path": "smooth-corners.tsx",
          "type": "registry:lib",
          "target": "lib/smooth-corners.tsx"
        }
      ]
    },
