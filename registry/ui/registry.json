{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Base UI button on Prometheus tokens: an elevated default plus five fallback variants, control-height sizes, inline icons, and the shared focus ring. Pill stays CSS rounded-full.",
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "utils",
        "AustinTByrd/prometheus/elevated",
        "AustinTByrd/prometheus/theme"
      ],
      "cssVars": {
        "light": {
          "button-primary": "#3b2a21",
          "button-primary-gradient": "linear-gradient(#665146 0%, #3b2a21 36.79% 60.86%, #503d33 100%)",
          "button-primary-border": "rgb(31 18 12 / 0.68)",
          "button-primary-foreground": "#fef1df"
        },
        "dark": {
          "button-primary": "#f4e2c8",
          "button-primary-gradient": "linear-gradient(#fffaf3 0%, #f4e2c8 36.79% 60.86%, #fbedd9 100%)",
          "button-primary-border": "rgb(64 46 37 / 0.68)",
          "button-primary-foreground": "#3b2a21"
        }
      },
      "files": [
        {
          "path": "button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ]
    },
