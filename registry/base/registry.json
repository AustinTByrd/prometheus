    {
      "name": "changelog",
      "type": "registry:item",
      "title": "Prometheus 0.2.0",
      "description": "Current registry version is 0.2.0. Compare it with the // @prometheus stamp in a copied file, then re-add items that are behind. Installing this writes PROMETHEUS.md.",
      "files": [
        {
          "path": "PROMETHEUS.md",
          "type": "registry:file",
          "target": "~/PROMETHEUS.md"
        }
      ]
    },
